# stash configuration — copy to ~/.config/stash/stash.toml (or point $STASH_CONFIG at it).
# Secrets never go in this file: OPENROUTER_API_KEY is read from the environment only.

data_dir = "~/.local/share/stash"   # holds stash.db
timezone = "America/Los_Angeles"
burst_window_seconds = 8.0          # messages arriving within this window get one combined reply

[llm]
provider = "ollama"                 # or "openrouter" — the one-line switch
busy_fallback = "wait"              # "wait" defers filing while the GPU is busy; "openrouter" files via the cloud instead

[llm.ollama]
base_url = "http://localhost:11434/v1"
model = "hermes3:8b"                # replace with the model the stash eval picks
# vision_model = "qwen2.5vl:7b"     # optional, used by the image eval arm

[llm.openrouter]
# base_url = "https://openrouter.ai/api/v1"
model = "nousresearch/hermes-4-70b" # example id, unverified — use one from the eval report
# vision_model = "..."              # optional
# The key comes from the environment: export OPENROUTER_API_KEY=...

# Per-task override: keep routine filing local, send heavier work to the cloud.
# Tasks: filing, suggestions, vision. Unlisted tasks use [llm] provider.
# [llm.tasks]
# suggestions = "openrouter"

# Model thinking per task. "default" (unlisted tasks) sends no thinking field; "off" asks the provider to skip thinking.
# [llm.thinking]
# filing = "off"   # stash's own calls only; Hermes agent turns are configured in Hermes
# Today only filing has a production LLM call, so vision and suggestions have no effect yet outside
# the eval; the eval's runs follow --thinking (default: the filing setting).

[gpu]
min_free_vram_mib = 9000            # below this much VRAM free for stash => busy
max_foreign_utilization_pct = 30    # other apps above this GPU load (stash model unloaded) => busy
manual_off_hours = 4.0              # how long `stash gpu off` lasts before it expires

# When nudges go out, in the timezone above. Times are "HH:MM" (24-hour); digest_day is a lowercase English day name.
# Uncomment to change a value; the rest keep these defaults.
# [nudges]
# digest_day = "sunday"
# digest_time = "10:00"
# reminder_time = "09:00"
# followup_time = "09:00"
# forgotten_after_days = 30
# stuck_doing_days = 21
# tick_seconds = 60
