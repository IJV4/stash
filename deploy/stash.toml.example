# stash configuration — copy to ~/.config/stash/stash.toml (or point $STASH_CONFIG at it).
# Secrets never go in this file: OPENROUTER_API_KEY is read from the environment only.

data_dir = "~/.local/share/stash"   # holds stash.db
timezone = "America/Los_Angeles"
burst_window_seconds = 8.0          # messages arriving within this window get one combined reply

[llm]
provider = "ollama"                 # or "openrouter" — the one-line switch
busy_fallback = "wait"              # "wait" defers filing while the GPU is busy; "openrouter" files via the cloud instead

[llm.ollama]
base_url = "http://localhost:11434/v1"
model = "qwen3.5:latest"           # replace with the model the stash eval picks
# vision_model = "qwen2.5vl:7b"     # optional, used by the image eval arm

[llm.openrouter]
# base_url = "https://openrouter.ai/api/v1"
# placeholder (no spaces allowed): an id OpenRouter does not offer makes `stash doctor` fail the `openrouter model` check
model = "<id-from-the-eval-report>"
# vision_model = "..."              # optional
# The key comes from the environment: export OPENROUTER_API_KEY=...

# Per-task override: keep routine filing local, send heavier work to the cloud.
# Tasks: filing, suggestions, vision. Unlisted tasks use [llm] provider.
# [llm.tasks]
# suggestions = "openrouter"

# Model thinking per task. "default" (unlisted tasks) sends no thinking field; "off" asks the provider to skip thinking.
[llm.thinking]
filing = "off"   # stash's own calls only; Hermes agent turns are configured in Hermes
# Tasks: filing, suggestions, vision. `suggestions` also covers step proposals (planning/proposer.py
# asks for LlmTask.SUGGESTIONS); `vision` has no production call until Plan 5.
# The eval's runs follow --thinking (default: the filing setting).

[gpu]
min_free_vram_mib = 9000            # below this much VRAM free for stash => busy
max_foreign_utilization_pct = 30    # other apps above this GPU load (stash model unloaded) => busy
manual_off_hours = 4.0              # how long `stash gpu off` lasts before it expires
# when nvidia-smi is missing or unreadable: "busy" (default) defers local-model work;
# set "free" on a CPU-only machine, where no reading is the normal state
# when_unreadable = "busy"

# When nudges go out, in the timezone above. Times are "HH:MM" (24-hour); digest_day is a lowercase English day name.
# Changing followup_time re-asks the unanswered follow-ups of the last 14 days once (one message);
# changing reminder_time or digest_time can repeat that day's sends once.
# auto_retry_minutes (0 to 1440) retries captures saved while the AI was unavailable, at most 3 per
# run and only when the GPU is free; you hear only when something was filed or turned out to be a question. 0 (the default) never
# retries by itself (set 30 to retry every 30 minutes); /stash_retry and `stash retry` always work.
# Uncomment to change a value; the rest keep these defaults.
# [nudges]
# digest_day = "sunday"
# digest_time = "10:00"
# reminder_time = "09:00"
# followup_time = "09:00"
# forgotten_after_days = 30
# stuck_doing_days = 21
# tick_seconds = 60
# auto_retry_minutes = 0

# How many days before a birthday, anniversary or other key date to be reminded; 0 is the day itself.
# Reminders go out at nudges.reminder_time. Each entry is 0 to 365 and none may repeat.
# [people]
# lead_days = [14, 2, 0]
